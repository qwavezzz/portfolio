---
import { withBase } from '../lib/paths';
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
---
<Shell title="Страница не найдена" page="404"><section class="inner-page not-found"><span class="error-number" aria-hidden="true">404_</span><h1 data-route-heading tabindex="-1">Кажется, такого<br />файла здесь нет.</h1><p>Ссылка могла измениться. Вернёмся к рабочему столу?</p><a class="button button-primary" href={withBase('/#desktop')}>На рабочий стол<Icon name="back" /></a><a class="text-link" href={withBase('/contact/')}>Контакты<Icon name="arrow" /></a></section></Shell>
