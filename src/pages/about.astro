---
import { withBase } from '../lib/paths';
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import Signal from '../components/Signal.astro';
import { profile, services } from '../data/portfolio';
---
<Shell title="Обо мне" page="about">
  <section class="inner-page about-page">
    <div class="window-bar"><span class="mono">qwave / обо мне</span><a class="text-link" href={withBase('/#desktop')} data-return-desktop><Icon name="back" />На рабочий стол</a></div>
    <div class="inner-title"><h1 data-route-heading tabindex="-1">За экраном —<br /><span class="soft-text">{profile.name}.</span></h1><span class="title-asterisk" aria-hidden="true">*</span></div>
    <div class="editorial-grid">
      <section class="editorial-copy"><h2>Немного<br />обо мне.</h2><p>{profile.about || 'Здесь скоро появится моя история: чем я занимаюсь, что мне интересно и как я смотрю на свою работу.'}</p>{!profile.about && <span class="content-status mono">Текст ещё готовится</span>}</section>
      <figure class="editorial-art"><Signal /><figcaption class="mono"><span>qwave — личное пространство</span><span aria-hidden="true">[ + ]</span></figcaption></figure>
      <section class="editorial-approach"><span class="editorial-rule"></span><h2>От идеи<br />до результата.</h2><p>{profile.approach || 'В этом разделе я расскажу о своём подходе: с чего начинается проект, как устроена работа и что помогает довести идею до результата.'}</p>{!profile.approach && <span class="content-status mono">Скоро подробнее</span>}</section>
      <section class="editorial-services"><h2>Что можно<br />сделать вместе.</h2><p>Услуги и ориентиры стоимости.</p>{services.length > 0 ? <div class="service-list">{services.map(service => <article class="service"><h3>{service.title}</h3><p>{service.description}</p><div class="service-price">{service.price}</div></article>)}</div> : <div class="price-empty"><span class="mono">Прайс готовится</span><p>Состав услуг и стоимость<br />появятся здесь.</p><span class="price-line" aria-hidden="true"></span></div>}<p class="price-note">Итоговая стоимость зависит от задачи и объёма работы.</p></section>
    </div>
    <div class="page-closing"><h2>Начнём<br />с разговора?</h2><a class="button button-primary" href={withBase('/contact/')}>Обсудить проект<Icon name="arrow" /></a></div>
    <a class="text-link page-return" href={withBase('/#desktop')} data-return-desktop><Icon name="back" />Вернуться на рабочий стол</a>
  </section>
</Shell>
